# 로컬 docker compose 전용 설정 — 복사해서 .env를 만들고 세 값을 채운다.
#   cp .env.example .env
# .env는 .gitignore 대상이라 저장소에 올라가지 않는다. 이 파일(.env.example)에는 값을 적지 않는다.
# 배포 환경(Render)에는 여기와 다른 값을 그쪽 환경변수로 넣는다.
#
# 값 만들기 예:  openssl rand -base64 32
#
# 이미 예전 compose로 MySQL 볼륨을 만든 적이 있다면, MySQL 계정 비밀번호는 볼륨을 처음 만들 때만 정해진다.
# 새 값으로 바꾸려면 한 번 `docker compose down -v`로 볼륨을 지우고 다시 띄운다 (로컬 데이터가 지워진다).

# MySQL root 비밀번호 (컨테이너 healthcheck가 씀)
MYSQL_ROOT_PASSWORD=

# 앱 계정 finuser의 비밀번호 — MySQL 계정 생성과 백엔드 접속에 같은 값을 쓴다
DB_PASSWORD=

# JWT 서명 키 (HS256) — 32바이트 이상
JWT_SECRET_KEY=
